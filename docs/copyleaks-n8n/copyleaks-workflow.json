      "parameters": {
        "jsCode": "const wh = $json;\nconst body = wh.body || {};\nconst v = wh.query && wh.query.v;\nreturn [{ json: {\n  version_id: v,\n  scan_id: v,\n  event_type: 'crawled',\n  result_id: null,\n  payload: JSON.stringify(body),\n} }];"
      }
    },
