      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 780],
      "parameters": {
        "jsCode": "const wh = $json;\nconst body = wh.body || {};\nconst v = wh.query && wh.query.v;\nconst rid = wh.query && wh.query.rid;\nreturn [{ json: {\n  version_id: v,\n  scan_id: v,\n  event_type: 'result',\n  result_id: rid || null,\n  payload: JSON.stringify(body),\n} }];"
      }
    },
    {
      "id": "insert_result",
