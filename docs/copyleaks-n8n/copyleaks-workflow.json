    {
      "id": "wh_export_completed",
      "name": "Webhook: Export Completed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 1000],
      "webhookId": "copyleaks-export-completed",
      "parameters": {
        "httpMethod": "POST",
        "path": "copyleaks/export-completed",
        "responseMode": "onReceived",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook: Submit": { "main": [[{ "node": "Login (submit)", "type": "main", "index": 0 }]] },
    "Login (submit)": { "main": [[{ "node": "Submit File", "type": "main", "index": 0 }]] },

    "Webhook: Status": { "main": [[{ "node": "IF completed", "type": "main", "index": 0 }]] },
    "IF completed": {
      "main": [
        [{ "node": "Prep completed row", "type": "main", "index": 0 }],
        [{ "node": "Prep error row", "type": "main", "index": 0 }]
      ]
    },
    "Prep completed row": { "main": [[{ "node": "Insert completed", "type": "main", "index": 0 }]] },
    "Insert completed": { "main": [[{ "node": "Login (export)", "type": "main", "index": 0 }]] },
    "Login (export)": { "main": [[{ "node": "Build export body", "type": "main", "index": 0 }]] },
    "Build export body": { "main": [[{ "node": "Trigger Export", "type": "main", "index": 0 }]] },
    "Prep error row": { "main": [[{ "node": "Insert error", "type": "main", "index": 0 }]] },

    "Webhook: Crawled": { "main": [[{ "node": "Prep crawled row", "type": "main", "index": 0 }]] },
    "Prep crawled row": { "main": [[{ "node": "Insert crawled", "type": "main", "index": 0 }]] },

    "Webhook: Result": { "main": [[{ "node": "Prep result row", "type": "main", "index": 0 }]] },
