# ============================================================================
# Tesis API — environment variables
# Copy this file to `.env` (same directory) and fill in real values.
# Never commit the real .env.
#
# IMPORTANT: After cloning this template, rename to `.env`:
#   cp env.example .env
# ============================================================================

# ---- App ----
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ---- Database (PostgreSQL + asyncpg) ----
# Local Postgres (default): use 127.0.0.1 explicitly on Windows — asyncpg's
# "localhost" tries IPv6 first and waits ~5s for the timeout. Linux/Mac can
# leave "localhost".
# Remote Postgres (VPS, managed cloud): use whatever host:port the provider
# gave you. The pool config in db/session.py already keeps a warm pool plus
# pre-ping, so the round-trip cost is paid only once per connection.
DATABASE_URL=postgresql+asyncpg://kimy:kimy@127.0.0.1:5433/kimy

# Pool tuning knobs (most users never touch these):
# SQL_ECHO=true              → log every SQL statement to stdout (debug only)
# DB_FORCE_NULL_POOL=true    → disable connection pooling (rare; only if you
#                              hit "Future attached to a different loop")

# ---- Redis (workers / rate limiting) ----
# Same rule as DATABASE_URL: 127.0.0.1 on Windows when running locally.
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Auth ----
# Minimum 32 bytes for HS256. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-32bytes-min-padding-padding
# 32-byte base64 Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-in-prod-32-bytes-base64-fernet=

# ---- LLM providers (at least one) ----
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- ORCID ----
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:3000/orcid/callback
ORCID_SANDBOX=true

# ---- Storage ----
STORAGE_BACKEND=local
STORAGE_PATH=./storage

# ============================================================================
# SMTP — Advisor sends acta PDF by email
# ============================================================================
# Gmail setup (recommended for personal / dev):
#   1) Enable 2-Step Verification on the Google account.
#   2) Create an App Password at https://myaccount.google.com/apppasswords
#      (Mail > "Otro" > name it "Tesis Backend").
#   3) Use the 16-char password below — NOT your normal account password.
#
# Production / institucional:
#   - smtp.gmail.com:587 also works with Google Workspace App Passwords.
#   - For SendGrid / Mailgun / Postmark: change host/port and use the API key
#     they give you as SMTP_PASSWORD.
#
# Leave everything blank if you don't want the email feature: the endpoint
# will respond 503 ("EmailNotConfiguredError") and the UI will surface a
# clean error to the user.
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM_EMAIL=tu-cuenta@gmail.com
SMTP_FROM_NAME=Plataforma Tesis
# true → STARTTLS on port 587 (Gmail default). Set to false + port 465 for SSL.
SMTP_USE_TLS=true

# ============================================================================
# Copyleaks — external plagiarism detection (optional)
# Register at https://copyleaks.com — free academic tier is available.
# Leave blank to disable: versions with enable_copyleaks=True will fail with
# a clear "Copyleaks auth error" message; intra-scan continues normally.
# ============================================================================
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
# Polling interval in seconds while waiting for scan results (default: 15).
COPYLEAKS_POLLING_INTERVAL_SEC=15
# Maximum wait time in seconds before marking the version as failed (default: 300).
COPYLEAKS_TIMEOUT_SEC=300
