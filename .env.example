# =============================================================================
# KIMY (RevisorTesis) — plantilla de variables de entorno
# =============================================================================
# Copia cada bloque al archivo que indica la sección. No subas archivos .env
# reales al repositorio.
#
#   API:     apps/api/.env
#   Web:     apps/web/.env.local   (o .env)
#   Mobile:  apps/mobile/.env
#   Docker:  infra/.env.prod.example → infra/.env.prod (solo producción)
# =============================================================================

# ---------------------------------------------------------------------------
# API (FastAPI) — archivo: apps/api/.env
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# Lista JSON en una sola línea (origen del front en desarrollo)
CORS_ORIGINS=["http://localhost:3000"]

# Postgres — con docker-compose local el puerto expuesto es 5433
DATABASE_URL=postgresql+asyncpg://kimy:kimy@localhost:5433/kimy

# Redis (broker/caché)
REDIS_URL=redis://localhost:6379/0

# Seguridad — en producción usar valores fuertes (ver infra/.env.prod.example)
JWT_SECRET=dev-only-secret-change-me-32bytes-min-padding-padding
ENCRYPTION_KEY=change-me-in-prod-32-bytes-base64-fernet=

# IA — Gemini es el proveedor principal
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Opcionales / legado
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ORCID OAuth
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:3000/orcid/callback
# true = sandbox.orcid.org; false = producción
ORCID_SANDBOX=true
# Umbral de similitud asesor↔tesis (embedding BoW por defecto ~0.35)
ORCID_ADVISOR_FIT_THRESHOLD=0.35

# CrossRef (User-Agent cortés: correo real)
CROSSREF_USER_AGENT=KIMY/0.1 (mailto:contact@example.com)

# Almacenamiento de archivos subidos
STORAGE_BACKEND=local
STORAGE_PATH=./storage

# Solo pruebas / desactivar rate limit en local si hace falta
# RATE_LIMIT_DISABLED=1

# ---------------------------------------------------------------------------
# Web (Next.js) — archivo: apps/web/.env.local
# ---------------------------------------------------------------------------
# URL pública del API (debe ser accesible desde el navegador)
NEXT_PUBLIC_API_URL=http://localhost:8005

# E2E (Playwright) — opcional; por defecto http://localhost:8005
# PLAYWRIGHT_API_BASE=http://localhost:8005

# ---------------------------------------------------------------------------
# Mobile (Expo) — archivo: apps/mobile/.env
# ---------------------------------------------------------------------------
# Emulador Android: 10.0.2.2 = máquina host. Dispositivo real: IP LAN del PC.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8005
